@using System.Globalization
@using LinearRegression.Web.Models

@if (IsVisible)
{
    <div class="add-values-backdrop" @onclick="OnClose">
        <section class="add-values-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="add-values-title"
                 @onclick:stopPropagation>
            <header class="add-values-header">
                <h2 id="add-values-title">Add X and Y Values</h2>
                <button type="button" class="modal-close-button" aria-label="Close" @onclick="OnClose">X</button>
            </header>
            <form class="add-values-form" @onsubmit="SubmitAndClose" @onsubmit:preventDefault>
                <div class="add-values-fields">
                    <label class="value-field">
                        <span>X Value</span>
                        <span class="number-input-wrap">
                            <input type="number" step="any" @bind="XValue" required aria-label="X Value" />
                            <span class="number-stepper" aria-label="Adjust X Value">
                                <button type="button" aria-label="Increase X Value" @onclick="() => AdjustValue(true, 1)">+</button>
                                <button type="button" aria-label="Decrease X Value" @onclick="() => AdjustValue(true, -1)">−</button>
                            </span>
                        </span>
                    </label>
                    <label class="value-field">
                        <span>Y Value</span>
                        <span class="number-input-wrap">
                            <input type="number" step="any" @bind="YValue" required aria-label="Y Value" />
                            <span class="number-stepper" aria-label="Adjust Y Value">
                                <button type="button" aria-label="Increase Y Value" @onclick="() => AdjustValue(false, 1)">+</button>
                                <button type="button" aria-label="Decrease Y Value" @onclick="() => AdjustValue(false, -1)">−</button>
                            </span>
                        </span>
                    </label>
                </div>
                @if (!string.IsNullOrEmpty(ValidationError))
                {
                    <p class="add-values-error" role="alert">@ValidationError</p>
                }
                <footer class="add-values-actions">
                    <button type="button" class="modal-secondary-button" @onclick="AddAndAnother">Add &amp; Another</button>
                    <button type="submit" class="modal-primary-button">Add</button>
                </footer>
            </form>
        </section>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<DataPoint> Points { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<DataPoint> OnAdd { get; set; }

    private string XValue { get; set; } = string.Empty;
    private string YValue { get; set; } = string.Empty;
    private string? ValidationError { get; set; }
    private bool WasVisible { get; set; }

    protected override void OnParametersSet()
    {
        if (IsVisible && !WasVisible)
        {
            XValue = string.Empty;
            YValue = string.Empty;
            ValidationError = null;
        }

        WasVisible = IsVisible;
    }

    private void AdjustValue(bool isX, int amount)
    {
        var current = ParseValue(isX ? XValue : YValue);
        var adjusted = (current ?? 0) + amount;
        if (isX)
        {
            XValue = adjusted.ToString("G", CultureInfo.InvariantCulture);
        }
        else
        {
            YValue = adjusted.ToString("G", CultureInfo.InvariantCulture);
        }

        ValidationError = null;
    }

    private Task SubmitAndClose() => AddValues(closeAfterAdd: true);

    private Task AddAndAnother() => AddValues(closeAfterAdd: false);

    private async Task AddValues(bool closeAfterAdd)
    {
        var x = ParseValue(XValue);
        var y = ParseValue(YValue);
        if (x is null || y is null)
        {
            ValidationError = "Enter a valid number for both X Value and Y Value.";
            return;
        }

        var id = Points.Select(point => point.Id).DefaultIfEmpty(0).Max() + 1;
        await OnAdd.InvokeAsync(new DataPoint(id, x.Value, y.Value));

        if (closeAfterAdd)
        {
            await OnClose.InvokeAsync();
            return;
        }

        XValue = string.Empty;
        YValue = string.Empty;
        ValidationError = null;
    }

    private static double? ParseValue(string value) =>
        double.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out var result) &&
        double.IsFinite(result)
            ? result
            : null;
}